# EB Docker Compose on AL2023: platform may leave stock nginx (static html) on
# instances that launch after scale-to-zero. We install the EB reverse-proxy
# layout and point upstream at 127.0.0.1:8080 (docker-proxy host port).

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_fix_nginx.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      UPSTREAM=/etc/nginx/conf.d/elasticbeanstalk-nginx-docker-upstream.conf
      NGINX_MAIN=/etc/nginx/nginx.conf
      EB_DIR=/etc/nginx/conf.d/elasticbeanstalk
      MARKER="# Mimir EB docker proxy"

      _needs_bootstrap() {
        if [ ! -f "$UPSTREAM" ]; then
          return 0
        fi
        if grep -q 'root[[:space:]]\+/usr/share/nginx/html' "$NGINX_MAIN" 2>/dev/null; then
          return 0
        fi
        return 1
      }

      _write_upstream() {
        cat > "$UPSTREAM" <<'EOF'
      upstream docker {
          server 127.0.0.1:8080;
          keepalive 256;
      }
      EOF
      }

      _write_healthd() {
        mkdir -p "$EB_DIR"
        cat > "$EB_DIR/healthd.conf" <<'EOF'
      if ($time_iso8601 ~ "^(\d{4})-(\d{2})-(\d{2})T(\d{2})") {
          set $year $1;
          set $month $2;
          set $day $3;
          set $hour $4;
      }

      access_log /var/log/nginx/healthd/application.log.$year-$month-$day-$hour healthd;
      EOF
        cat > /etc/nginx/conf.d/healthd_logformat.conf <<'EOF'
      log_format healthd  '$msec"$uri"'
                          '$status"$request_time"$upstream_response_time"'
                          '$http_x_forwarded_for';
      EOF
      }

      _write_nginx_main() {
        cat > "$NGINX_MAIN" <<'EOF'
      # Elastic Beanstalk Nginx Configuration File (Mimir bootstrap)

      user  nginx;
      worker_processes  auto;
      error_log  /var/log/nginx/error.log;
      pid        /var/run/nginx.pid;
      worker_rlimit_nofile    200000;

      events {
          worker_connections  1024;
      }

      http {
          include       /etc/nginx/mime.types;
          default_type  application/octet-stream;

          access_log    /var/log/nginx/access.log;

          log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                                '$status $body_bytes_sent "$http_referer" '
                                '"$http_user_agent" "$http_x_forwarded_for"';

          include  conf.d/*.conf;

          map $http_upgrade $connection_upgrade {
                  default       "upgrade";
          }

          server {
              listen 80 default_server;
              gzip on;
              gzip_comp_level 4;
              gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript;

              access_log    /var/log/nginx/access.log main;

              location / {
                  proxy_pass            http://docker;
                  proxy_http_version    1.1;

                  proxy_set_header    Connection             $connection_upgrade;
                  proxy_set_header    Upgrade                $http_upgrade;
                  proxy_set_header    Host                   $host;
                  proxy_set_header    X-Real-IP              $remote_addr;
                  proxy_set_header    X-Forwarded-For        $proxy_add_x_forwarded_for;
              }

              include conf.d/elasticbeanstalk/*.conf;
          }
      }
      EOF
      }

      if _needs_bootstrap; then
        echo "Bootstrapping EB nginx proxy (upstream missing or stock nginx.conf)"
        _write_upstream
        _write_healthd
        _write_nginx_main
      elif [ -f "$UPSTREAM" ]; then
        sed -i 's|server [0-9\.]*:[0-9]*;|server 127.0.0.1:8080;|g' "$UPSTREAM"
        echo "Patched existing upstream → 127.0.0.1:8080"
      fi

      mkdir -p /var/log/nginx/healthd
      systemctl enable nginx 2>/dev/null || true
      if nginx -t; then
        systemctl restart nginx
        echo "nginx restarted with EB docker proxy"
      else
        echo "nginx -t failed" >&2
        exit 1
      fi

  "/etc/systemd/system/nginx-eb-proxy-fix.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Bootstrap or patch EB nginx upstream for Docker Compose
      After=nginx.service docker.service
      Wants=docker.service

      [Service]
      Type=oneshot
      ExecStartPre=/bin/sleep 5
      ExecStart=/opt/elasticbeanstalk/hooks/appdeploy/post/99_fix_nginx.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

container_commands:
  01_run_nginx_fix_after_deploy:
    command: "/opt/elasticbeanstalk/hooks/appdeploy/post/99_fix_nginx.sh"

commands:
  01_enable_nginx_fix:
    command: "systemctl daemon-reload && systemctl enable nginx-eb-proxy-fix.service || true"
